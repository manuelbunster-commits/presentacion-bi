<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporte de Originación — Banco Internacional</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    background: #f0f4f8;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
  }

  .slide {
    width: 1100px;
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  }

  /* ── Header ── */
  .header {
    background: linear-gradient(135deg, #003087 0%, #0055b3 60%, #0078d4 100%);
    padding: 2.4rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .header::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 280px; height: 280px;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
  }
  .header::after {
    content: '';
    position: absolute;
    bottom: -80px; right: 160px;
    width: 200px; height: 200px;
    background: rgba(255,255,255,0.04);
    border-radius: 50%;
  }
  .header-left { position: relative; z-index: 1; }
  .header-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.5rem;
  }
  .header-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .header-subtitle {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
    margin-top: 0.4rem;
    font-weight: 400;
  }
  .header-logo {
    position: relative;
    z-index: 1;
    background: white;
    border-radius: 14px;
    padding: 0.7rem 1.2rem;
  }
  .header-logo img { height: 44px; display: block; }

  /* ── Body ── */
  .body { padding: 2.4rem 3rem 2.8rem; }

  /* ── KPI Grid ── */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-bottom: 2.4rem;
  }
  .kpi-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s;
  }
  .kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 16px 16px 0 0;
  }
  .kpi-card.blue::before  { background: #0055b3; }
  .kpi-card.green::before { background: #16a34a; }
  .kpi-card.red::before   { background: #dc2626; }
  .kpi-card.amber::before { background: #d97706; }

  .kpi-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
    margin-bottom: 0.7rem;
  }
  .kpi-value {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .kpi-value.small { font-size: 1.35rem; }
  .kpi-sub {
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 0.45rem;
    font-weight: 500;
  }

  /* ── Section title ── */
  .section-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  /* ── Table ── */
  .credits-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
  }
  .credits-table thead tr {
    background: #f1f5f9;
  }
  .credits-table th {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .credits-table th:last-child { text-align: right; }
  .credits-table th:first-child { border-radius: 10px 0 0 10px; }
  .credits-table th:last-child  { border-radius: 0 10px 10px 0; }
  .credits-table td {
    padding: 0.9rem 1rem;
    font-size: 0.88rem;
    color: #1e293b;
    border-bottom: 1px solid #f1f5f9;
  }
  .credits-table td:last-child {
    text-align: right;
    font-weight: 700;
    color: #0f172a;
  }
  .credits-table td.rut {
    font-family: monospace;
    font-size: 0.8rem;
    color: #64748b;
  }
  .credits-table .total-row td {
    border-bottom: none;
    border-top: 2px solid #e2e8f0;
    font-weight: 700;
    color: #0055b3;
    font-size: 0.92rem;
    padding-top: 1rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  /* ── Footer ── */
  .footer {
    border-top: 1px solid #f1f5f9;
    padding: 1.2rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-note {
    font-size: 0.72rem;
    color: #94a3b8;
  }
  .footer-brand {
    font-size: 0.72rem;
    color: #cbd5e1;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
</style>
</head>
<body>
<div class="slide">

  <!-- Header -->
  <div class="header">
    <div class="header-left">
      <div class="header-tag">Reporte de Originación</div>
      <div class="header-title">Créditos Cursados</div>
      <div class="header-subtitle">Abril 2026 &nbsp;·&nbsp; Alianza Relif × Banco Internacional</div>
    </div>
    <div class="header-logo">
      <img src="data:image/png;base64," alt="Banco Internacional">
    </div>
  </div>

  <!-- Body -->
  <div class="body">

    <!-- KPI Cards -->
    <div class="kpi-grid">
      <div class="kpi-card blue">
        <div class="kpi-label">Monto Originado</div>
        <div class="kpi-value small">$69.100.000</div>
        <div class="kpi-sub">cursado + rechazado</div>
      </div>
      <div class="kpi-card green">
        <div class="kpi-label">Monto Cursado</div>
        <div class="kpi-value small">$37.100.000</div>
        <div class="kpi-sub">4 créditos aprobados</div>
      </div>
      <div class="kpi-card red">
        <div class="kpi-label">Monto Rechazado</div>
        <div class="kpi-value small">$32.000.000</div>
        <div class="kpi-sub">por tasa o riesgo</div>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-label">Ticket Promedio</div>
        <div class="kpi-value">$9.275.000</div>
        <div class="kpi-sub">por crédito cursado</div>
      </div>
    </div>

    <!-- Table -->
    <div class="section-title">Detalle de créditos cursados</div>
    <table class="credits-table">
      <thead>
        <tr>
          <th>RUT</th>
          <th>Nombre</th>
          <th>Estado</th>
          <th>Monto</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="rut">9.903.096-8</td>
          <td>Jaime Fica</td>
          <td><span class="badge">✓ Cursado</span></td>
          <td>$6.650.000</td>
        </tr>
        <tr>
          <td class="rut">13.244.326-2</td>
          <td>Cristina Sanz</td>
          <td><span class="badge">✓ Cursado</span></td>
          <td>$14.000.000</td>
        </tr>
        <tr>
          <td class="rut">24.042.847-4</td>
          <td>Daniel Lopez Chavez</td>
          <td><span class="badge">✓ Cursado</span></td>
          <td>$9.150.000</td>
        </tr>
        <tr>
          <td class="rut">19.503.291-2</td>
          <td>Ian Inostroza</td>
          <td><span class="badge">✓ Cursado</span></td>
          <td>$7.300.000</td>
        </tr>
        <tr class="total-row">
          <td colspan="3">Total cursado</td>
          <td>$37.100.000</td>
        </tr>
      </tbody>
    </table>

  </div>

  <!-- Footer -->
  <div class="footer">
    <div class="footer-note">Información confidencial · Uso interno Relif × Banco Internacional</div>
    <div class="footer-brand">RELIF · Abril 2026</div>
  </div>

</div>
</body>
</html>
